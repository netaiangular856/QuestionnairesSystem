{
  "ConnectionStrings": {
    // استبدل بسلسلة الاتصال الفعلية للاستضافة (مثل موفّر SQL السحابي أو السيرفر الداخلي).
    // مثال محلي للاختبار دون تثبيت SQL كامل: يمكن استخدام LocalDB بنفس نمط التطوير.
    //"QuestionnairesDb": "Server=YOUR_SQL_HOST;Database=QuestionnairesSystem;User Id=...;Password=...;Encrypt=True;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "QuestionnairesDb": "Server=(localdb)\\mssqllocaldb;Database=QuestionnairesSystem_Prod;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "QuestionnairesSystem",
    "Audience": "QuestionnairesSystem.Client",
    "SigningKey": "REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentitySeed": {
    "RunOnStartup": true,
    "BootstrapAdmin": true,
    "AdminEmail": "admin@localhost",
    "AdminUserName": "admin",
    "AdminPassword": "ChangeMe!1"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
